// Job Filler — local portal database schema.
// Single-user, local-first: there is no account system, so the tables below
// have no owner/user column. `Profile` is a singleton row (id always 1).
// Stored in a local SQLite file (see DATABASE_URL in .env) — no external
// database service required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id                   Int      @id @default(autoincrement())
  firstName            String   @default("")
  middleName           String?
  lastName             String   @default("")
  preferredName        String?
  dateOfBirth          String?
  email                String   @default("")
  phone                String?
  phoneCountry         String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  region               String?
  postcode             String?
  country              String   @default("GB")
  nationality          String?
  rightToWorkUK        Boolean?
  needsVisaSponsorship Boolean?
  linkedinUrl          String?
  portfolioUrl         String?
  githubUrl            String?
  updatedAt            DateTime @updatedAt
}

model Education {
  id                String  @id @default(cuid())
  sortOrder         Int     @default(0)
  institution       String
  qualificationType String
  fieldOfStudy      String?
  gradeType         String
  gradeValue        String?
  startDate         String? // YYYY-MM
  endDate           String?
  current           Boolean @default(false)
  description       String?
}

model Experience {
  id             String  @id @default(cuid())
  sortOrder      Int     @default(0)
  jobTitle       String
  employer       String
  location       String?
  employmentType String?
  startDate      String  // YYYY-MM
  endDate        String?
  current        Boolean @default(false)
  description    String?
}

model CustomAnswer {
  id         String  @id @default(cuid())
  key        String  @unique
  label      String
  value      String
  /// JSON-encoded string[] — SQLite has no native array column type.
  matchHints String  @default("[]")
  sensitive  Boolean @default(false)
}
