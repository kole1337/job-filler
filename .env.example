# ---- apps/web ----

# Neon Postgres (pooled connection for the app, direct connection for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-west-2.aws.neon.tech/job_filler?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-west-2.aws.neon.tech/job_filler?sslmode=require"

# Auth.js
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# JWT signing for extension access tokens (separate from AUTH_SECRET)
EXT_JWT_SECRET="run: openssl rand -base64 32"

# AES-256-GCM key for encrypting sensitive PII columns. 32 bytes, base64.
ENCRYPTION_KEY="run: openssl rand -base64 32"

# Email (Resend). Leave RESEND_API_KEY empty in dev to log verification links to the console.
RESEND_API_KEY=""
EMAIL_FROM="Job Filler <noreply@example.com>"

# Rate limiting (Upstash Redis). Leave empty in dev to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Comma-separated extension origins allowed to call the API with credentials.
# Fill these once the extension IDs are known (see packages/extension/README.md).
ALLOWED_EXTENSION_ORIGINS="chrome-extension://REPLACE_WITH_CHROME_ID,moz-extension://REPLACE_WITH_FIREFOX_UUID"

# Public base URL of the portal, embedded in the built extension.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- packages/extension ----
# Default portal URL the extension talks to (override in the extension options page).
WXT_PORTAL_URL="http://localhost:3000"
