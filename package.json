{
  "name": "job-filler",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-browser extension + web portal to autofill UK job applications on Workday, Greenhouse, Lever and Ashby.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @job-filler/web",
    "dev:ext": "npm run dev --workspace @job-filler/extension",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @job-filler/web",
    "build:ext": "npm run build --workspace @job-filler/extension",
    "db:migrate": "npm run db:migrate --workspace @job-filler/web",
    "db:studio": "npm run db:studio --workspace @job-filler/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
